<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.layout.StackPane?>

<!-- One tilled plot. Click to water, or to harvest a grown tree. -->
<StackPane fx:id="root" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="garden.PlotController" styleClass="plot"
           onMouseClicked="#onClicked">
    <Canvas fx:id="canvas"/>
</StackPane>
